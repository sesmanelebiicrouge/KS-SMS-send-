# Orange Developer — server-side only; never use NEXT_PUBLIC_ prefixes.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Exact sender address provided by Orange, e.g. tel:+2250000 only if confirmed for your app.
ORANGE_SENDER_ADDRESS=

# Exact custom sender name approved/whitelisted by Orange (max 11 alphanumeric characters/spaces).
ORANGE_SENDER_NAME=

# Leave false until credentials, contract, sender authorization, and OTP flow are tested.
ORANGE_SMS_ENABLED=false

# Persistent rate-limit and OTP storage (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a random secret of at least 32 bytes. Keep private and consistent across deployments.
OTP_SECRET=

# Supabase email OTP / authentication settings are configured separately in Supabase and Vercel.
# Never commit actual secrets or put private keys in NEXT_PUBLIC_ variables.
