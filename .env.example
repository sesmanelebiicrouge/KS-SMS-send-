# Public Supabase settings used by the browser and server-side session verification.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Orange Developer credentials: keep server-side only; never prefix with NEXT_PUBLIC_.
# Prefer the complete Authorization header from Orange Developer (usually "Basic ...").
ORANGE_AUTHORIZATION_HEADER=
# Alternatively set both values below; the server will construct the Basic header.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Keep false until Orange OAuth has been tested and an SMS bundle is purchased.
# Set to "true" only when ready to send one test SMS at a time.
ORANGE_SMS_ENABLED=false
