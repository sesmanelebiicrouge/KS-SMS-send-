# Copy to .env.local for local development. Never commit real secrets.
# Supabase project URL and publishable/anon key (public client key only).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Configure a provider-specific secret only after choosing and implementing
# a supported SMS provider. Keep provider credentials server-side only.
# SMS_PROVIDER=
# SMS_PROVIDER_API_KEY=
