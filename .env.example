# Orange Developer credentials — keep real values private.
# Configure these exact names in Vercel for Production (and Preview if needed).
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Sender address/ID authorized for your Orange SMS API account.
# Use the exact sender address supplied or approved by Orange; do not invent one.
ORANGE_SENDER_ADDRESS=

# Do not add real credentials to this file or commit a .env.local file.
# A configured variable does not prove the credentials are valid or that SMS sending is enabled.
